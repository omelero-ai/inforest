<?xml version="1.0" encoding="utf-8"?>
<Report ScriptLanguage="CSharp" ReportInfo.Author="INFOREST" ReportInfo.Description="Registro de Ventas Detallado/Estado/Correlativo - Legacy: frmRepRegistroVenta.frm / spRep_RegVenta - BR-REP-022">
  <Dictionary>
    <TableDataSource Name="RegistroVenta" DataType="System.Int32" Enabled="true">
      <Column Name="FRegistro" DataType="System.DateTime" />
      <Column Name="TDocumento" DataType="System.String" />
      <Column Name="TCodigoCliente" DataType="System.String" />
      <Column Name="NNeto" DataType="System.Double" />
